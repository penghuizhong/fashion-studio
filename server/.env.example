# SoulChat MVP 后端配置示例
# 复制为 .env 后填写：  cp .env.example .env

# OpenRouter API Key。三种情况：
# 1) 自己用：填你的 key，所有人共用；
# 2) 给多人用（BYOK）：留空，每个人在网页「设置 → API Key」填自己的 key；
# 3) MOCK_LLM=true 时可留空。
# 注意：公网部署给陌生人用时请留空，否则访客会烧你的钱。
# 在 https://openrouter.ai/keys 获取
OPENROUTER_API_KEY=

# OpenRouter 接口地址（一般不用改）
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 聊天用模型（OpenRouter 模型名）
CHAT_MODEL=deepseek/deepseek-chat

# 记忆提取/摘要用模型（可用更便宜的模型省钱）
EXTRACT_MODEL=deepseek/deepseek-chat

# 单次请求的上下文 token 预算，超了自动裁剪最早的对话原文
CONTEXT_BUDGET=8000

# 每产生 N 条 assistant 消息触发一次自动记忆提取
EXTRACT_EVERY_N=5

# 服务端口
PORT=3001

# true = 用假数据流测试，不需要真 key
MOCK_LLM=false

# 数据库目录
DATA_DIR=./data

# 代理（可选）：Node 的 fetch 默认不走系统代理。
# 如果你在大陆用 Clash/V2Ray 等代理工具，取消下一行注释，
# 把端口改成你的代理工具的 HTTP 端口（Clash Verge 默认 7890）：
# HTTPS_PROXY=http://127.0.0.1:7890

# ===== 多用户模式（公开给陌生人用时开启）=====
# true = 开启：需要注册/登录，所有数据按用户隔离，Key 由用户登录后在网页上填写并加密存后端
# 不填/false = 单用户本地模式（默认）
MULTI_USER=false

# 多用户模式必填：AES-256-GCM 加密用户 Key 用的 64 位 hex 密钥
# 生成：openssl rand -hex 32   —— 必须保密，泄露后所有托管 Key 都要重填
# MASTER_KEY=

# 多用户模式必填：会话签名密钥，随便填一串随机字符，生成：openssl rand -hex 32
# SESSION_SECRET 已废弃（v1.7.1+ 不再需要）

# 反向代理后面是真正的 HTTPS（生产经 Caddy）时设为 true，开启完整安全头
# （HSTS + upgrade-insecure-requests）。本地 http 开发保持 false/不填，
# 否则浏览器会把 http 子资源升级成 https 请求导致白屏（Safari 必现）。
BEHIND_HTTPS=false

# ===== 语音功能（DashScope）=====
# 语音识别/合成用的 Key，在 https://bailian.console.aliyun.com 获取
# DASHSCOPE_API_KEY=

# DashScope 接口地址（可选）：默认 https://dashscope.aliyuncs.com
# 如果你用的是千问 token-plan 等有独立 API 地址的套餐，取消下一行注释并改成你的地址
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ===== 万能画板多步 Agent（默认关闭，旧单步生图继续可用）=====
# 需要 Node >=22.19.0，建议与 CI 一致使用 Node 24。
AGENT_ENABLED=false
# 可选：禁用指定内置技能，逗号分隔；仅影响新报价，已确认任务使用冻结快照。
# AGENT_DISABLED_SKILLS=multi-view,product-photo
